{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snax.example/contracts/config-dump-manifest.schema.json",
  "title": "SNAX 1C Configuration Dump Manifest",
  "description": "Metadata of an out-of-band 1C dump intake. Payload files stay outside Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intakeId",
    "receivedAt",
    "sourceOwner",
    "classification",
    "gitPolicy",
    "intendedUse",
    "bases",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "intakeId": {
      "type": "string",
      "format": "uuid"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "classification": {
      "type": "string",
      "enum": ["INTERNAL", "RESTRICTED", "CONFIDENTIAL"]
    },
    "gitPolicy": {
      "type": "string",
      "const": "DO_NOT_COMMIT_PAYLOAD"
    },
    "intendedUse": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CATALOG",
          "RECONCILIATION",
          "UAT",
          "EXTENSION_AUDIT",
          "TRAINING_COPY"
        ]
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "period": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NONE", "PARTIAL", "DONE", "NOT_APPLICABLE"]
        },
        "maskedFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseCode", "contour", "status"],
        "properties": {
          "baseCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "contour": {
            "type": "string",
            "enum": [
              "UT_CENTRAL",
              "UT_LEGACY",
              "UT_IMPORT",
              "RETAIL_CENTRAL",
              "RETAIL_REGION",
              "RETAIL_FRANCHISE",
              "BP_SNEX",
              "BP_SIBIR",
              "OTHER"
            ]
          },
          "displayName": {
            "type": ["string", "null"],
            "maxLength": 300
          },
          "platformVersion": {
            "type": ["string", "null"],
            "maxLength": 32
          },
          "configurationName": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "configurationVersion": {
            "type": ["string", "null"],
            "maxLength": 64
          },
          "supportMode": {
            "type": ["string", "null"],
            "enum": ["ON_SUPPORT", "PARTIAL", "OFF_SUPPORT", "UNKNOWN"]
          },
          "unknownReason": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": ["PLANNED", "UNVERIFIED", "VERIFIED", "REJECTED"]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "fileName",
          "mediaType",
          "sha256",
          "sizeBytes",
          "kind"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\\\/]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 322122547200
          },
          "kind": {
            "type": "string",
            "enum": [
              "DT",
              "CF",
              "CFE",
              "XML_CONFIG",
              "XLSX_REGISTRY",
              "EXCHANGE_LOG",
              "PROTOCOL_PDF",
              "OTHER"
            ]
          },
          "baseCode": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          }
        }
      }
    }
  }
}
