{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snax.example/contracts/processing-job-message-v1.schema.json",
  "title": "ProcessingJobMessageV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "eventType",
    "importId",
    "processingRunId",
    "runNumber",
    "dispatchGeneration",
    "correlationId",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "IMPORT_PROCESSING_REQUESTED"},
    "importId": {"type": "string", "format": "uuid"},
    "processingRunId": {"type": "string", "format": "uuid"},
    "runNumber": {"type": "integer", "minimum": 1},
    "dispatchGeneration": {"type": "integer", "minimum": 1},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 100},
    "requestedAt": {"type": "string", "format": "date-time"},
    "retryOfRunId": {"type": ["string", "null"], "format": "uuid"}
  },
  "maxProperties": 10
}
