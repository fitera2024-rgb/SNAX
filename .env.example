# Application
APP_ENV=local
APP_NAME=snax-order-import
APP_VERSION=0.0.0-dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=snax_import
POSTGRES_USER=snax
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://snax:change-me-local-only@postgres:5432/snax_import

# Redis
REDIS_URL=redis://redis:6379/0
QUEUE_BROKER_URL=redis://redis:6379/0
QUEUE_NAME=snax.import.processing.v1
QUEUE_VISIBILITY_TIMEOUT_SECONDS=3600
QUEUE_MESSAGE_MAX_BYTES=16384

# Transactional outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LOCK_SECONDS=30
OUTBOX_MAX_PUBLISH_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=60

# Worker delivery, lease and retry
WORKER_ID=snax-worker-local
WORKER_CONCURRENCY=1
WORKER_PREFETCH_MULTIPLIER=1
WORKER_SOFT_TIME_LIMIT_SECONDS=840
WORKER_HARD_TIME_LIMIT_SECONDS=900
JOB_LEASE_SECONDS=45
JOB_HEARTBEAT_SECONDS=10
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_SECONDS=5
PROCESSING_RETRY_MAX_SECONDS=300
PROCESSING_RETRY_MULTIPLIER=2
PROCESSING_RETRY_JITTER_RATIO=0.2
PROCESSING_AUTOSTART=false
PROCESSOR_MODE=disabled
RECOVERY_POLL_INTERVAL_SECONDS=5
QUEUE_REDELIVERY_AFTER_SECONDS=120

# S3-compatible object storage / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=snax-import-local
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# WORK-002 import limits/storage policy
TEMP_DIRECTORY=
VERIFY_OBJECT_DIGEST=true

# File limits — baseline, final values are configured per environment
MAX_UPLOAD_BYTES=104857600
MAX_WORKBOOK_SHEETS=100
MAX_SHEET_ROWS=1000000
MAX_SHEET_COLUMNS=500
MAX_DECOMPRESSION_RATIO=100

# 1C integration (disabled in TASK-000)
ONEC_BASE_URL=
ONEC_CLIENT_ID=
ONEC_CLIENT_SECRET=
ONEC_POLLING_ENABLED=false

# Never place production credentials in this file or Git.
